# Copy to .env for local development. Never commit .env.
# Production values go in your host's secret manager (Vercel env vars, worker host secrets).
# Nothing here is a real secret. Never put secrets in NEXT_PUBLIC_* variables.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL. Local: run `pnpm db:local` and use the printed URL.
# Production: a managed PostgreSQL (Neon, Supabase, RDS...) with sslmode=require.
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────────
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Clerk (production auth, supports MFA). When both are set, dev login is disabled automatically.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Dev login (seeded users, no password). Ignored in production and whenever Clerk is configured.
DEV_AUTH_ENABLED=true

# ── AI gateway ──────────────────────────────────────────────────
# anthropic | openai-compatible   (leave empty: AI features show "not configured", the rest works)
AI_PROVIDER=
AI_GATEWAY_API_KEY=
# Required for openai-compatible (e.g. https://ai-gateway.vercel.sh/v1). Optional override for anthropic.
AI_BASE_URL=
AI_DEFAULT_MODEL=
# Optional USD prices per million tokens. Without them, cost is recorded as "unknown", never guessed,
# and budgets cannot be enforced.
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=2048

# ── Meta / Instagram (Instagram API with Instagram Login) ───────
# See docs/operations/meta-setup.md. ID/secret are the *Instagram* app ID/secret
# from "API setup with Instagram login", not the Meta app's basic settings.
META_APP_ID=
META_APP_SECRET=
# Must match the OAuth redirect URI in the app dashboard exactly (public https for real use).
META_REDIRECT_URI=http://localhost:3000/api/v1/integrations/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
# Optional: webhook fields to subscribe each connected account to, e.g. comments,messages
META_WEBHOOK_FIELDS=
META_GRAPH_API_VERSION=v26.0
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

# ── Secrets at rest ─────────────────────────────────────────────
# 32 random bytes, base64. Same value on web and worker. Never stored in the database.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=
SECRETS_KEY_VERSION=1
# For rotation: "1:<old base64 key>,2:<older>"
SECRETS_PREVIOUS_KEYS=

# ── Object storage (S3-compatible, private bucket) ──────────────
# Must be reachable from the internet for Instagram publishing (not localhost).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=8388608

# ── Worker ──────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_LOCK_TIMEOUT_MS=300000

# ── Observability ───────────────────────────────────────────────
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
